# Copy to .env. Paths are relative to the project working directory.
# These bundled tables contain invented demonstration records only.
OMOP_CONCEPT_PATH=examples/synthetic/CONCEPT.csv
OMOP_CONCEPT_SYNONYM_PATH=examples/synthetic/CONCEPT_SYNONYM.csv
OMOP_VOCABULARY_PATH=examples/synthetic/VOCABULARY.csv
OMOP_ATHENA_RELEASE=synthetic-v1
OMOP_EFFECTIVE_DATE=2026-01-01

# OpenAI-compatible Chat Completions endpoint and local credentials.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-with-authorized-model
LLM_API_KEY=
# Optional legacy alias, used only when LLM_API_KEY is empty:
# LLM_MODEL_API_KEY=
LLM_TIMEOUT_SECONDS=60
# auto is the default: explicitly disable only on documented first-party models.
# disabled fails before network if unsupported. enabled/adaptive/low are model-specific;
# provider_default omits all thinking/reasoning fields.
LLM_TRANS_THINKING_MODE=auto
